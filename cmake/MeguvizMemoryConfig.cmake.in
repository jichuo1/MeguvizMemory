@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
include("${CMAKE_CURRENT_LIST_DIR}/MeguvizMemoryTargets.cmake")

# All declared imported configurations (and any default) must resolve to this
# package's same binary; checking only the first can mix Debug and Release SDKs.
function(_MeguvizMemory_locations_match target expected result)
  set(_valid TRUE)
  set(_found FALSE)
  if(NOT EXISTS "${expected}")
    set(_valid FALSE)
  else()
    file(REAL_PATH "${expected}" _expected_real)
    get_target_property(_configs "${target}" IMPORTED_CONFIGURATIONS)
    if(_configs)
      foreach(_config IN LISTS _configs)
        string(TOUPPER "${_config}" _upper)
        get_target_property(_location "${target}" "IMPORTED_LOCATION_${_upper}")
        if(NOT _location OR NOT EXISTS "${_location}")
          set(_valid FALSE)
        else()
          set(_found TRUE)
          file(REAL_PATH "${_location}" _real)
          if(NOT _real STREQUAL _expected_real)
            set(_valid FALSE)
          endif()
        endif()
      endforeach()
    endif()
    get_target_property(_default "${target}" IMPORTED_LOCATION)
    if(_default)
      if(NOT EXISTS "${_default}")
        set(_valid FALSE)
      else()
        set(_found TRUE)
        file(REAL_PATH "${_default}" _real)
        if(NOT _real STREQUAL _expected_real)
          set(_valid FALSE)
        endif()
      endif()
    endif()
    # A mapping can select an otherwise undeclared IMPORTED_LOCATION (for
    # example DEBUG -> OTHER), so validate every active and standard mapping.
    set(_requested_configs DEBUG RELEASE RELWITHDEBINFO MINSIZEREL NOCONFIG)
    if(CMAKE_BUILD_TYPE)
      list(APPEND _requested_configs "${CMAKE_BUILD_TYPE}")
    endif()
    if(CMAKE_CONFIGURATION_TYPES)
      list(APPEND _requested_configs ${CMAKE_CONFIGURATION_TYPES})
    endif()
    list(REMOVE_DUPLICATES _requested_configs)
    foreach(_requested IN LISTS _requested_configs)
      string(TOUPPER "${_requested}" _requested_upper)
      get_property(_has_mapping TARGET "${target}" PROPERTY "MAP_IMPORTED_CONFIG_${_requested_upper}" SET)
      if(_has_mapping)
        get_target_property(_mapping "${target}" "MAP_IMPORTED_CONFIG_${_requested_upper}")
        set(_mapping_selected FALSE)
        if(_mapping STREQUAL "")
          set(_mapping_location "${_default}")
          get_property(_candidate_set TARGET "${target}" PROPERTY IMPORTED_LOCATION SET)
          if(_candidate_set)
            set(_mapping_selected TRUE)
          endif()
        else()
          foreach(_mapped IN LISTS _mapping)
            if(_mapped STREQUAL "")
              set(_mapping_location "${_default}")
              get_property(_candidate_set TARGET "${target}" PROPERTY IMPORTED_LOCATION SET)
            elseif(NOT _mapped MATCHES "^[A-Za-z0-9_+-]+$")
              set(_valid FALSE)
              set(_mapping_location "")
              set(_candidate_set FALSE)
            else()
              string(TOUPPER "${_mapped}" _mapped_upper)
              get_property(_candidate_set TARGET "${target}" PROPERTY "IMPORTED_LOCATION_${_mapped_upper}" SET)
              get_target_property(_mapping_location "${target}" "IMPORTED_LOCATION_${_mapped_upper}")
            endif()
            # CMake selects the first mapped configuration whose location is
            # set, even if that value is empty or names a nonexistent file.
            if(_candidate_set)
              set(_mapping_selected TRUE)
              break()
            endif()
          endforeach()
        endif()
        if(NOT _mapping_selected OR NOT EXISTS "${_mapping_location}")
          set(_valid FALSE)
        else()
          file(REAL_PATH "${_mapping_location}" _mapping_real)
          if(NOT _mapping_real STREQUAL _expected_real)
            set(_valid FALSE)
          endif()
        endif()
      else()
        # Without a mapping, an unlisted direct configuration can be selected.
        get_property(_direct_set TARGET "${target}" PROPERTY "IMPORTED_LOCATION_${_requested_upper}" SET)
        get_target_property(_direct_location "${target}" "IMPORTED_LOCATION_${_requested_upper}")
        if(_direct_set)
          if(NOT _direct_location OR NOT EXISTS "${_direct_location}")
            set(_valid FALSE)
          else()
            file(REAL_PATH "${_direct_location}" _direct_real)
            if(NOT _direct_real STREQUAL _expected_real)
              set(_valid FALSE)
            endif()
          endif()
        endif()
      endif()
    endforeach()
  endif()
  if(NOT _found)
    set(_valid FALSE)
  endif()
  set(${result} "${_valid}" PARENT_SCOPE)
endfunction()

# The generated shared targets have no legacy transitive link interface.
# Reject pre-existing or modified imports that add one via older properties.
function(_MeguvizMemory_legacy_links_empty target result)
  set(_valid TRUE)
  foreach(_property IN ITEMS IMPORTED_LINK_INTERFACE_LIBRARIES)
    get_target_property(_value "${target}" "${_property}")
    if(_value)
      set(_valid FALSE)
    endif()
  endforeach()
  set(_configs DEBUG RELEASE RELWITHDEBINFO MINSIZEREL NOCONFIG)
  get_target_property(_declared "${target}" IMPORTED_CONFIGURATIONS)
  if(_declared)
    list(APPEND _configs ${_declared})
  endif()
  if(CMAKE_BUILD_TYPE)
    list(APPEND _configs "${CMAKE_BUILD_TYPE}")
  endif()
  if(CMAKE_CONFIGURATION_TYPES)
    list(APPEND _configs ${CMAKE_CONFIGURATION_TYPES})
  endif()
  set(_mapped_configs)
  foreach(_config IN LISTS _configs)
    string(TOUPPER "${_config}" _upper)
    get_property(_has_mapping TARGET "${target}" PROPERTY "MAP_IMPORTED_CONFIG_${_upper}" SET)
    if(_has_mapping)
      get_target_property(_mapping "${target}" "MAP_IMPORTED_CONFIG_${_upper}")
      if(_mapping)
        list(APPEND _mapped_configs ${_mapping})
      endif()
    endif()
  endforeach()
  list(APPEND _configs ${_mapped_configs})
  list(REMOVE_DUPLICATES _configs)
  foreach(_config IN LISTS _configs)
    string(TOUPPER "${_config}" _upper)
    foreach(_property IN ITEMS IMPORTED_LINK_INTERFACE_LIBRARIES)
      get_target_property(_value "${target}" "${_property}_${_upper}")
      if(_value)
        set(_valid FALSE)
      endif()
    endforeach()
  endforeach()
  set(${result} "${_valid}" PARENT_SCOPE)
endfunction()

# The optional JNI composition is installed separately from the core package.
# Never expose an Android ELF to a host build, and do not make old core-only
# installations depend on its presence. Consumers may request it explicitly
# with find_package(MeguvizMemory CONFIG REQUIRED COMPONENTS android_jni).
set(MeguvizMemory_android_jni_FOUND FALSE)
set(_mgmem_jni_abi_file "${CMAKE_CURRENT_LIST_DIR}/MeguvizMemoryAndroidJniABI.cmake")
set(_mgmem_jni_targets "${CMAKE_CURRENT_LIST_DIR}/MeguvizMemoryAndroidJniTargets.cmake")
if(ANDROID AND CMAKE_SYSTEM_NAME STREQUAL "Android" AND EXISTS "${_mgmem_jni_abi_file}" AND EXISTS "${_mgmem_jni_targets}")
  unset(MeguvizMemory_ANDROID_JNI_ABI)
  include("${_mgmem_jni_abi_file}")
  set(_mgmem_requested_abi "${CMAKE_ANDROID_ARCH_ABI}")
  if(NOT _mgmem_requested_abi)
    set(_mgmem_requested_abi "${ANDROID_ABI}")
  endif()
  get_target_property(_mgmem_core_kind MeguvizMemory::mgmem TYPE)
  get_target_property(_mgmem_core_links MeguvizMemory::mgmem INTERFACE_LINK_LIBRARIES)
  _MeguvizMemory_legacy_links_empty(MeguvizMemory::mgmem _mgmem_core_legacy_empty)
  if(_mgmem_requested_abi AND _mgmem_requested_abi STREQUAL MeguvizMemory_ANDROID_JNI_ABI
      AND (NOT ANDROID_ABI OR ANDROID_ABI STREQUAL _mgmem_requested_abi)
      AND _mgmem_core_kind STREQUAL "SHARED_LIBRARY" AND NOT _mgmem_core_links AND _mgmem_core_legacy_empty)
    unset(_mgmem_elf_prefix)
    unset(_mgmem_elf_machine)
    # Check the ELF class, byte order and machine of both installed libraries;
    # metadata by itself must not admit a manually mixed-ABI package.
    if(_mgmem_requested_abi STREQUAL "arm64-v8a")
      set(_mgmem_elf_prefix "7f454c460201")
      set(_mgmem_elf_machine "b700")
    elseif(_mgmem_requested_abi STREQUAL "x86_64")
      set(_mgmem_elf_prefix "7f454c460201")
      set(_mgmem_elf_machine "3e00")
    elseif(_mgmem_requested_abi STREQUAL "armeabi-v7a")
      set(_mgmem_elf_prefix "7f454c460101")
      set(_mgmem_elf_machine "2800")
    elseif(_mgmem_requested_abi STREQUAL "x86")
      set(_mgmem_elf_prefix "7f454c460101")
      set(_mgmem_elf_machine "0300")
    endif()
    get_filename_component(_mgmem_jni_libdir "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
    set(_mgmem_jni_binary "${_mgmem_jni_libdir}/libmgmem_pressure_jni.so")
    set(_mgmem_core_binary "${_mgmem_jni_libdir}/libmgmem.so")
    _MeguvizMemory_locations_match(MeguvizMemory::mgmem "${_mgmem_core_binary}" _mgmem_core_locations_ok)
    set(_mgmem_elf_ok TRUE)
    if(NOT _mgmem_elf_prefix OR NOT _mgmem_core_locations_ok OR NOT EXISTS "${_mgmem_jni_binary}")
      set(_mgmem_elf_ok FALSE)
    else()
      file(REAL_PATH "${_mgmem_jni_libdir}" _mgmem_jni_libdir_real)
      foreach(_mgmem_binary IN ITEMS "${_mgmem_core_binary}" "${_mgmem_jni_binary}")
        file(REAL_PATH "${_mgmem_binary}" _mgmem_binary_real)
        cmake_path(IS_PREFIX _mgmem_jni_libdir_real "${_mgmem_binary_real}" NORMALIZE _mgmem_binary_inside)
        if(NOT _mgmem_binary_inside)
          set(_mgmem_elf_ok FALSE)
        endif()
      endforeach()
      foreach(_mgmem_binary IN ITEMS "${_mgmem_core_binary}" "${_mgmem_jni_binary}")
        file(READ "${_mgmem_binary}" _mgmem_header OFFSET 0 LIMIT 20 HEX)
        string(LENGTH "${_mgmem_header}" _mgmem_header_length)
        if(_mgmem_header_length LESS 40)
          set(_mgmem_elf_ok FALSE)
        else()
          string(SUBSTRING "${_mgmem_header}" 0 12 _mgmem_header_prefix)
          string(SUBSTRING "${_mgmem_header}" 32 4 _mgmem_header_type)
          string(SUBSTRING "${_mgmem_header}" 36 4 _mgmem_header_machine)
          if(NOT _mgmem_header_prefix STREQUAL _mgmem_elf_prefix OR
             NOT _mgmem_header_type STREQUAL "0300" OR
             NOT _mgmem_header_machine STREQUAL _mgmem_elf_machine)
            set(_mgmem_elf_ok FALSE)
          endif()
        endif()
      endforeach()
    endif()
    # CMake's generated export can either create the target or return early
    # when it already exists. Validate the resulting target in both cases.
    if(_mgmem_elf_ok)
      include("${_mgmem_jni_targets}")
      if(NOT TARGET MeguvizMemory::android_jni)
        set(_mgmem_elf_ok FALSE)
      endif()
    endif()
    if(_mgmem_elf_ok)
      get_target_property(_mgmem_existing_jni_kind MeguvizMemory::android_jni TYPE)
      get_target_property(_mgmem_existing_jni_links MeguvizMemory::android_jni INTERFACE_LINK_LIBRARIES)
      _MeguvizMemory_locations_match(MeguvizMemory::android_jni "${_mgmem_jni_binary}" _mgmem_jni_locations_ok)
      if(NOT _mgmem_jni_locations_ok OR
          NOT _mgmem_existing_jni_kind STREQUAL "SHARED_LIBRARY" OR
          NOT _mgmem_existing_jni_links STREQUAL "MeguvizMemory::mgmem")
        set(_mgmem_elf_ok FALSE)
      endif()
    endif()
    if(_mgmem_elf_ok)
      set(MeguvizMemory_android_jni_FOUND TRUE)
    endif()
  endif()
endif()
if(ANDROID AND CMAKE_SYSTEM_NAME STREQUAL "Android" AND TARGET MeguvizMemory::android_jni
    AND NOT MeguvizMemory_android_jni_FOUND)
  # CMake cannot remove a target after inclusion. Never report this package as
  # usable when an incompatible JNI target remains visible to the caller.
  set(MeguvizMemory_FOUND FALSE)
  set(MeguvizMemory_NOT_FOUND_MESSAGE "Android JNI target is incompatible with this package")
endif()
if("android_jni" IN_LIST MeguvizMemory_FIND_COMPONENTS AND NOT MeguvizMemory_android_jni_FOUND)
  set(MeguvizMemory_NOT_FOUND_MESSAGE "Android JNI is not installed for the requested Android ABI")
endif()
unset(_mgmem_jni_abi_file)
unset(_mgmem_jni_targets)
unset(_mgmem_requested_abi)
unset(_mgmem_core_kind)
unset(_mgmem_core_links)
unset(_mgmem_core_legacy_empty)
unset(_mgmem_core_binary)
unset(_mgmem_core_locations_ok)
unset(_mgmem_jni_binary)
unset(_mgmem_jni_libdir)
unset(_mgmem_jni_libdir_real)
unset(_mgmem_binary_real)
unset(_mgmem_binary_inside)
unset(_mgmem_elf_prefix)
unset(_mgmem_elf_machine)
unset(_mgmem_elf_ok)
unset(_mgmem_binary)
unset(_mgmem_header)
unset(_mgmem_header_length)
unset(_mgmem_header_prefix)
unset(_mgmem_header_type)
unset(_mgmem_header_machine)
unset(_mgmem_existing_jni_kind)
unset(_mgmem_existing_jni_links)
unset(_mgmem_jni_locations_ok)
check_required_components(MeguvizMemory)
