@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(MeguvizMemory 0.2 CONFIG REQUIRED)
find_dependency(MeguvizCompute CONFIG REQUIRED)
include(CheckCXXSourceCompiles)
set(_mgmem_bridge_saved_required_libraries "${CMAKE_REQUIRED_LIBRARIES}")
set(CMAKE_REQUIRED_LIBRARIES MeguvizMemory::mgmem)
unset(_mgmem_bridge_has_checked_release CACHE)
check_cxx_source_compiles("#include <mgmem/mgmem.h>
int main() { return (int)mgmem_import_external_checked_v1(nullptr, nullptr, nullptr); }"
  _mgmem_bridge_has_checked_release)
set(CMAKE_REQUIRED_LIBRARIES "${_mgmem_bridge_saved_required_libraries}")
unset(_mgmem_bridge_saved_required_libraries)
if(NOT _mgmem_bridge_has_checked_release)
  message(FATAL_ERROR "MeguvizMemoryComputeReadBridge requires a Memory SDK with checked external release; ABI 1.1 alone is insufficient")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/MeguvizMemoryComputeReadBridgeTargets.cmake")
check_required_components(MeguvizMemoryComputeReadBridge)
